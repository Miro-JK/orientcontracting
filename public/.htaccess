# Orient Palace website: server rules for Apache / LiteSpeed (Hostinger).
# Upload this file together with the rest of the public/ folder.

Options -Indexes -MultiViews
DirectoryIndex index.html
ErrorDocument 404 /404.html
ErrorDocument 403 /404.html
ErrorDocument 410 /404.html
AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1. Always use HTTPS
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # 2. Block hidden files/folders (.git, .env, ...) but allow .well-known (SSL checks)
  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteRule (^|/)\. - [F]

  # 3. Static site with no forms: only reading is allowed
  RewriteCond %{REQUEST_METHOD} !^(GET|HEAD)$
  RewriteRule ^ - [F]

  # 4. WordPress is gone: its paths, any PHP file and feeds answer "410 Gone", so bots
  #    and Google stop asking. Also drops the spam pages that were injected into WordPress.
  RewriteRule ^(wp-[^/]*|xmlrpc\.php)(/|$) - [G,L]
  RewriteRule \.php$ - [G,L]
  RewriteRule (^|/)feed/?$ - [G,L]
  RewriteRule ^(olimp-kazino[^/]*|sc-helper|ppp)/?$ - [G,L]
  RewriteCond %{QUERY_STRING} (^|&)(p|page_id|s|author)= [NC]
  RewriteRule ^$ /? [R=301,L]

  # 5. Old WordPress page addresses -> matching new pages (keeps Google rankings and old links)
  RewriteRule ^(home|homepage|main-page|welcome(-[0-9]+)?|3d-slide-page)/?$ / [R=301,L]
  RewriteRule ^(about-us(-[0-9]+)?|introduction|our-story|our-values|mission-and-vision|ceo-message)/?$ /about [R=301,L]
  RewriteRule ^(building-contracting|carpentry-joinery-services|ceiling-services|electrical-serives|flooring-services|masonry-services|painting-polishing-cleaning-services|partition-services|plumbing-sanitary-services|roofing-warehouse-contracting|water-proofing-services)/?$ /services [R=301,L]
  RewriteRule ^(complete-projects|running-projects|future-projects|project-videos)/?$ /projects [R=301,L]
  RewriteRule ^(contact-us|quotaion)/?$ /contact [R=301,L]

  # 6. /index or /index.html -> /
  RewriteCond %{THE_REQUEST} \s/+index(\.html)?[\s?]
  RewriteRule ^ / [R=301,L]

  # 7. /about.html -> /about  (keeps old links and bookmarks working)
  RewriteCond %{THE_REQUEST} \s/+([^\s?]+?)\.html[\s?]
  RewriteRule ^ /%1 [R=301,L]

  # 8. /about/ -> /about
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+)/$ /$1 [R=301,L]

  # 9. Serve /about from about.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^([^./]+)$ $1.html [L]
</IfModule>

# Never serve backups, logs, configs or source files that end up here by mistake
<FilesMatch "(\.(bak|old|orig|swp|sql|log|ini|sh|py|md|lock|env|zip|tar|gz)|~)$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()"
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Cross-Origin-Resource-Policy "same-origin"
  Header always set X-Permitted-Cross-Domain-Policies "none"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; frame-src https://www.google.com https://maps.google.com; connect-src 'none'; form-action 'none'; base-uri 'self'; frame-ancestors 'self'; object-src 'none'; upgrade-insecure-requests"
  Header always unset X-Powered-By
  Header unset X-Powered-By

  # Cache images for a week; always re-check HTML, CSS and JS so updates show up immediately
  <FilesMatch "\.(jpg|jpeg|png|webp|svg|ico|woff2?)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <FilesMatch "\.(html|css|js)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript image/svg+xml text/plain application/xml
</IfModule>
